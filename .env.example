# copie para .env (o .env nao vai para o git)

# banco: django.db.backends.mysql, django.db.backends.postgresql ou django.db.backends.sqlite3
# com sqlite3 as outras variaveis DB_* nao sao usadas (o arquivo e o db.sqlite3 da raiz)
DB_ENGINE=django.db.backends.mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=caminho_esperanca
DB_USER=
DB_PASSWORD=

# so no site publicado (Render): DEBUG=False e uma SECRET_KEY longa e secreta.
# no computador de quem desenvolve, deixe as duas comentadas
# DEBUG=False
# SECRET_KEY=
